# Copy to .env. With NOTHING set, the app runs fully offline in demo mode (mock LLM, mock DigiLocker/eKYC,
# in-memory DB, browser speech fallback). Every variable below is optional unless marked.
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SERVE_WEB=false

# Database: leave empty for the in-memory store (data lost on restart); set for MongoDB Atlas.
DB_MODE=
MONGO_URI=

# Secrets. REQUIRED when NODE_ENV=production; throwaway values are generated in dev/test.
JWT_SECRET=
FIELD_ENCRYPTION_KEY=      # 64 hex chars (32 bytes): openssl rand -hex 32
PHONE_HASH_SALT=
ADMIN_PASSCODE=

# Gemini (assistant brain). LLM_MODE=mock uses the offline rule-based NLU.
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bhashini (speech + translation). "fallback" uses Gemini / browser Web Speech / cached strings.
BHASHINI_MODE=fallback
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# DigiLocker / Aadhaar eKYC. Live mode needs partner credentials and is NOT implemented in this prototype.
DIGILOCKER_MODE=mock
AADHAAR_MODE=mock

# WhatsApp via Twilio Sandbox. "mock" validates signatures against a well-known test token.
WHATSAPP_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

GRIEVANCE_CONTACT=grievance@digischeme.example (prototype contact)
LOG_LEVEL=info
